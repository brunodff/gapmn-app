{
  "manifest_version": 3,
  "name": "SILOMS — Nome dos Documentos",
  "version": "1.0.0",
  "description": "Salva os documentos baixados do SILOMS com o assunto do documento no nome do arquivo, em vez de \"DOCUMENTO - 1\".",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.siloms.intraer/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage"
  ],
  "host_permissions": [
    "*://*.siloms.intraer/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "siloms-nomes@gapmn.app",
      "strict_min_version": "115.0"
    }
  }
}
