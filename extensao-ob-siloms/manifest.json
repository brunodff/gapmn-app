{
  "manifest_version": 3,
  "name": "GAPMN — Anexador de Ordens Bancárias SILOMS",
  "version": "2.6.1",
  "description": "Lê as OBs da UG na planilha do Tesouro Gerencial, gera o comprovante (modelo oficial, com banco/agência/conta) e anexa no SILOMS.",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "*://*.siloms.intraer/*",
    "https://fychrtyyqbzlfbzbvzqp.supabase.co/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://script.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Anexador de OBs"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_title": "Anexador de OBs",
    "default_panel": "sidepanel.html",
    "open_at_install": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.siloms.intraer/*"
      ],
      "js": [
        "jspdf.umd.min.js",
        "jspdf.plugin.autotable.min.js",
        "obs-portal.js",
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ob-siloms@gapmn.app",
      "strict_min_version": "128.0"
    }
  },
  "icons": {}
}
